{
  "name": "@agentforge/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentforge": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./repl": {
      "types": "./dist/repl.d.ts",
      "import": "./dist/repl.js"
    },
    "./print-mode": {
      "types": "./dist/print-mode.d.ts",
      "import": "./dist/print-mode.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@agentforge/harness": "workspace:*",
    "@agentforge/shared": "workspace:*",
    "@earendil-works/pi-agent-core": "^0.79.9",
    "@earendil-works/pi-ai": "^0.79.9",
    "typebox": "1.1.38"
  }
}
